          "orderId": {
            "type": "string",
            "nullable": true
          },
          "orderName": {
            "type": "string",
            "nullable": true
          },
          "orderTotalPrice": {
            "type": "number",
            "format": "double"
          },
          "orderStatus": {
            "type": "string",
            "nullable": true
          },
          "orderCreatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "orderCreatedBy": {
            "type": "string",
            "nullable": true
          },
          "orderUserNic": {
            "type": "string",
            "nullable": true
          },
          "productId": {
            "type": "integer",
            "format": "int64"
          },
          "orderItemProductName": {
            "type": "string",
            "nullable": true
          },
          "orderItemQuantity": {
            "type": "integer",
            "format": "int32"
          },
          "orderItemUnitPrice": {
            "type": "number",
            "format": "double"
          },
          "orderItemTotalPrice": {
            "type": "number",
            "format": "double"
          },
          "productName": {
            "type": "string",
            "nullable": true
          },
          "productPrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "OrderRequest": {
        "type": "object",
        "properties": {
          "orderName": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemRequest"
            },
            "nullable": true
          },
          "rowVersion": {
            "type": "string",
            "nullable": true
          },
          "orderId": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "images": {
            "type": "array",
